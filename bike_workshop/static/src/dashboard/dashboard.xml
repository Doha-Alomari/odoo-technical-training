<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="bike_workshop.WorkshopDashboard">

        <div class="container-fluid py-4">

            <!-- Header -->
            <div class="mb-4">

                <h1 class="fw-bold mb-1">
                    Workshop Operations Dashboard
                </h1>

                <p class="text-muted">
                    Today's workshop activity
                </p>

            </div>


            <!-- Dashboard Cards -->
            <div class="row g-4">

                <!-- Active Rentals -->
                <div class="col-12 col-md-4">

                    <div
                        class="card h-100 shadow-sm"
                        t-on-click="openActiveRentals"
                        style="cursor: pointer;"
                    >

                        <div class="card-body p-4">

                            <p class="text-muted mb-2">
                                ACTIVE RENTALS
                            </p>

                            <h1 class="display-4 fw-bold mb-2">
                                <t t-esc="dashboardData.active_rentals_today"/>
                            </h1>

                            <p class="text-muted mb-0">
                                Rentals active today
                            </p>

                        </div>

                        <div class="card-footer bg-transparent">
                            <span class="text-primary">
                                View active rentals →
                            </span>
                        </div>

                    </div>

                </div>


                <!-- Returns Due -->
                <div class="col-12 col-md-4">

                    <div
                        class="card h-100 shadow-sm"
                        t-on-click="openReturnsDue"
                        style="cursor: pointer;"
                    >

                        <div class="card-body p-4">

                            <p class="text-muted mb-2">
                                RETURNS DUE
                            </p>

                            <h1 class="display-4 fw-bold mb-2">
                                <t t-esc="dashboardData.returns_due_today"/>
                            </h1>

                            <p class="text-muted mb-0">
                                Returns due today
                            </p>

                        </div>

                        <div class="card-footer bg-transparent">
                            <span class="text-primary">
                                View returns →
                            </span>
                        </div>

                    </div>

                </div>


                <!-- Repairs In Progress -->
                <div class="col-12 col-md-4">

                    <div
                        class="card h-100 shadow-sm"
                        t-on-click="openRepairsInProgress"
                        style="cursor: pointer;"
                    >

                        <div class="card-body p-4">

                            <p class="text-muted mb-2">
                                REPAIRS IN PROGRESS
                            </p>

                            <h1 class="display-4 fw-bold mb-2">
                                <t t-esc="dashboardData.repairs_in_progress"/>
                            </h1>

                            <p class="text-muted mb-0">
                                Repairs currently in progress
                            </p>

                        </div>

                        <div class="card-footer bg-transparent">
                            <span class="text-primary">
                                View repairs →
                            </span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </t>

</templates>