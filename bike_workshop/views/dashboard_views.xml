<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bike_workshop_dashboard_form" model="ir.ui.view">
        <field name="name">bike.workshop.dashboard.form</field>
        <field name="model">bike.workshop.dashboard</field>
        <field name="arch" type="xml">

            <form string="Workshop Operations Dashboard">

                <sheet>

                    <h1>Workshop Operations Dashboard</h1>

                    <div class="row mt-4">

                        <!-- Active Rentals Today -->
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">

                                    <h3>Active Rentals Today</h3>

                                    <button
                                        name="action_view_active_rentals"
                                        type="object"
                                        class="btn btn-link"
                                    >
                                        <h1>
                                            <field name="active_rentals_today"/>
                                        </h1>
                                    </button>

                                </div>
                            </div>
                        </div>

                        <!-- Returns Due Today -->
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">

                                    <h3>Returns Due Today</h3>

                                    <button
                                        name="action_view_returns_due"
                                        type="object"
                                        class="btn btn-link"
                                    >
                                        <h1>
                                            <field name="returns_due_today"/>
                                        </h1>
                                    </button>

                                </div>
                            </div>
                        </div>

                        <!-- Repairs In Progress -->
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body">

                                    <h3>Repairs In Progress</h3>

                                    <button
                                        name="action_view_repairs_in_progress"
                                        type="object"
                                        class="btn btn-link"
                                    >
                                        <h1>
                                            <field name="repairs_in_progress"/>
                                        </h1>
                                    </button>

                                </div>
                            </div>
                        </div>

                    </div>

                </sheet>

            </form>

        </field>
    </record>

   <record id="action_bike_workshop_dashboard_client" model="ir.actions.client">
        <field name="name">Workshop Dashboard</field>
        <field name="tag">bike_workshop.dashboard</field>
    </record>

    <menuitem
        id="menu_bike_workshop_dashboard"
        name="Dashboard"
        parent="menu_bike_workshop_root"
        action="action_bike_workshop_dashboard_client"
        sequence="1"
    />

</odoo>