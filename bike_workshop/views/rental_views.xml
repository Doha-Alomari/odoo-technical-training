<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bike_workshop_rental_search" model="ir.ui.view">
        <field name="name">bike.workshop.rental.search</field>
        <field name="model">bike.workshop.rental</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="state"/>

                <filter name="confirmed_rentals"
                        string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>

                <filter name="returned_rentals"
                        string="Returned"
                        domain="[('state', '=', 'returned')]"/>
            </search>
        </field>
    </record>

    <record id="view_bike_workshop_rental_list" model="ir.ui.view">
        <field name="name">bike.workshop.rental.list</field>
        <field name="model">bike.workshop.rental</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="start_date"/>
                <field name="expected_return_date"/>
                <field name="daily_price"/>
                <field name="duration"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bike_workshop_rental_form" model="ir.ui.view">
        <field name="name">bike.workshop.rental.form</field>
        <field name="model">bike.workshop.rental</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_return"
                            string="Return"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="bike_id"/>
                            <field name="daily_price"/>
                        </group>

                        <group>
                            <field name="start_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                            <field name="duration"/>
                            <field name="total_amount"/>
                        </group>
                    </group>

                    <group>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bike_workshop_rental" model="ir.actions.act_window">
        <field name="name">All Rentals</field>
        <field name="res_model">bike.workshop.rental</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bike_workshop_confirmed_rentals"
            model="ir.actions.act_window">
        <field name="name">Confirmed Rentals</field>
        <field name="res_model">bike.workshop.rental</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'confirmed')]</field>
    </record>

    <menuitem id="menu_bike_workshop_rentals"
              name="Rentals"
              parent="menu_bike_workshop_root"/>

    <menuitem id="menu_bike_workshop_all_rentals"
              name="All Rentals"
              parent="menu_bike_workshop_rentals"
              action="action_bike_workshop_rental"/>

    <menuitem id="menu_bike_workshop_confirmed_rentals"
              name="Confirmed Rentals"
              parent="menu_bike_workshop_rentals"
              action="action_bike_workshop_confirmed_rentals"/>

</odoo>