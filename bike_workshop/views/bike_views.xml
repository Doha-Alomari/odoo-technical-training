<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bike_workshop_search" model="ir.ui.view">
        <field name="name">bike.workshop.search</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>

                <filter name="electric_bikes"
                        string="Electric"
                        domain="[('bike_type', '=', 'electric')]"/>
            </search>
        </field>
    </record>

    <record id="view_bike_workshop_list" model="ir.ui.view">
        <field name="name">bike.workshop.list</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="purchase_date"/>
                <field name="last_maintenance_date"/>
                <field name="daily_rental_price"/>
                <field name="wheel_size"/>
            </list>
        </field>
    </record>

    <record id="view_bike_workshop_form" model="ir.ui.view">
        <field name="name">bike.workshop.form</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_rentals"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar">
                        <field name="rental_count"
                               widget="statinfo"
                               string="Rentals"/>
                    </button>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="brand"/>
                        <field name="bike_type"/>
                        <field name="purchase_date"/>
                        <field name="last_maintenance_date"/>
                        <field name="daily_rental_price"/>
                        <field name="wheel_size"/>
                    </group>

                    <group string="Service Information">
                        <field name="assigned_mechanic"/>
                        <field name="last_service_date"/>
                        <field name="service_notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bike_workshop" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bike_workshop_root"
              name="Bike Workshop"/>

    <menuitem id="menu_bike_workshop_bikes"
              name="Bikes"
              parent="menu_bike_workshop_root"
              action="action_bike_workshop"/>

</odoo>