<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bike_workshop_list" model="ir.ui.view">
        <field name="name">bike.workshop.list</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand"/>
                <field name="bike_type"/>
                <field name="purchase_date"/>
                <field name="last_maintenance_date"/>
                <field name="daily_rental_price"/>
                <field name="wheel_size"/>
                
            </list>
        </field>
    </record>

    <record id="view_bike_workshop_form" model="ir.ui.view">
        <field name="name">bike.workshop.form</field>
        <field name="model">bike.workshop.bike</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="brand"/>
                        <field name="bike_type"/>
                        <field name="purchase_date"/>
                        <field name="last_maintenance_date"/>
                        <field name="daily_rental_price"/>
                        <field name="wheel_size"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bike_workshop" model="ir.actions.act_window">
        <field name="name">Bikes</field>
        <field name="res_model">bike.workshop.bike</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bike_workshop_root"
              name="Bike Workshop"/>

    <menuitem id="menu_bike_workshop_bikes"
              name="Bikes"
              parent="menu_bike_workshop_root"
              action="action_bike_workshop"/>

</odoo>