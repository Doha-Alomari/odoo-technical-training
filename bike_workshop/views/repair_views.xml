<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_bike_workshop_repair_search" model="ir.ui.view">
        <field name="name">bike.workshop.repair.search</field>
        <field name="model">bike.workshop.repair</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_id"/>
                <field name="assigned_mechanic"/>
                <field name="state"/>

                <filter name="in_progress_repairs"
                        string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>

                <filter name="completed_repairs"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="cancelled_repairs"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="view_bike_workshop_repair_list" model="ir.ui.view">
        <field name="name">bike.workshop.repair.list</field>
        <field name="model">bike.workshop.repair</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="bike_source"/>
                <field name="bike_id"/>
                <field name="assigned_mechanic"/>
                <field name="last_service_date"/>
                <field name="total_parts_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bike_workshop_repair_form" model="ir.ui.view">
        <field name="name">bike.workshop.repair.form</field>
        <field name="model">bike.workshop.repair</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button name="action_start"
                            string="Start Repair"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_complete"
                            string="Complete Repair"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>

                    <button name="action_cancel"
                            string="Cancel Repair"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'in_progress')"/>

                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="bike_source"/>
                            <field name="bike_id"
                                   invisible="bike_source != 'workshop'"/>
                        </group>

                        <group>
                            <field name="external_reference"
                                   invisible="bike_source != 'external'"/>

                            <field name="external_brand"
                                   invisible="bike_source != 'external'"/>

                            <field name="external_bike_type"
                                   invisible="bike_source != 'external'"/>
                        </group>
                    </group>

                    <group>
                        <field name="reported_issue"/>
                        <field name="assigned_mechanic"/>
                    </group>

                    <group>
                        <field name="last_service_date"/>
                        <field name="service_notes"/>
                    </group>

                    <notebook>
                        <page string="Spare Parts">
                            <field name="part_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"
                                           domain="[('product_tmpl_id.is_spare_part', '=', True)]"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        <group>
                            <field name="total_parts_cost" string="Total Parts Cost"/>
                        </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bike_workshop_repair" model="ir.actions.act_window">
        <field name="name">Repairs</field>
        <field name="res_model">bike.workshop.repair</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bike_workshop_repairs"
              name="Repairs"
              parent="menu_bike_workshop_root"
              action="action_bike_workshop_repair"/>

</odoo>