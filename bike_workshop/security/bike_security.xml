<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="group_bike_workshop_staff" model="res.groups">
        <field name="name">Workshop Staff</field>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('bike_workshop.group_bike_workshop_staff'))]"/>
    </record>
    <record id="bike_workshop_rental_portal_rule" model="ir.rule">
        <field name="name">Portal: Own Rentals Only</field>
        <field name="model_id" ref="model_bike_workshop_rental"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('customer_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>