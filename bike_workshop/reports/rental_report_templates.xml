<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Main report template -->
    <template id="rental_agreement_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="rental">

                <t t-call="bike_workshop.rental_agreement_document"
                   t-lang="rental.customer_id.lang"/>

            </t>
        </t>
    </template>


    <!-- Translatable rental agreement document -->
    <template id="rental_agreement_document">

        <!--
            Re-browse the rental using the customer's language.
            This makes translated fields and selection values use
            the customer's language.
        -->
        <t t-set="rental"
           t-value="rental.with_context(lang=rental.customer_id.lang)"/>

        <t t-call="web.external_layout">

            <style>
                .bike-rental-report .o_company_logo_big {
                    width: 320px !important;
                    max-width: 320px !important;
                    height: auto !important;
                    display: block !important;
                    margin-left: auto !important;
                    margin-right: auto !important;
                }
            </style>

            <div
                class="page bike-rental-report"
                t-att-dir="'rtl' if rental.customer_id.lang == 'ar_001' else 'ltr'"
                t-att-style="'direction: rtl; text-align: right;' if rental.customer_id.lang == 'ar_001' else 'direction: ltr; text-align: left;'"
            >

                <!-- Header -->
                <div style="border-bottom: 4px solid #DDECC0; padding-bottom: 15px; margin-bottom: 25px;">
                    <h1 style="color: #343434; font-size: 26px; margin-top: 15px; margin-bottom: 0;">
                        Rental Agreement
                    </h1>
                </div>


                <!-- Customer & Bike Information -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 22px;">
                    <tr>
                        <td colspan="2"
                            style="background-color: #DDECC0; color: #343434; border: 1px solid #DDECC0; padding: 10px; font-size: 15px;">
                            <strong>Customer &amp; Bike Information</strong>
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50%; border: 1px solid #ddd; padding: 11px;">
                            <strong style="color: #343434;">
                                Customer :
                            </strong>
                            <span t-field="rental.customer_id"/>
                        </td>

                        <td style="width: 50%; border: 1px solid #ddd; padding: 11px;">
                            <strong style="color: #343434;">
                                Bike :
                            </strong>
                            <span t-field="rental.bike_id"/>
                        </td>
                    </tr>
                </table>


                <!-- Rental Information -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 22px;">
                    <tr>
                        <td colspan="2"
                            style="background-color: #DDECC0; color: #343434; border: 1px solid #DDECC0; padding: 10px; font-size: 15px;">
                            <strong>Rental Information</strong>
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50%; border: 1px solid #ddd; padding: 10px;">
                            <strong style="color: #343434;">
                                Rental Reference :
                            </strong>
                            <span t-field="rental.name"/>
                        </td>

                        <td style="width: 50%; border: 1px solid #ddd; padding: 10px;">
                            <strong style="color: #343434;">
                                Status :
                            </strong>
                            <span t-field="rental.state"/>
                        </td>
                    </tr>

                    <tr>
                        <td style="border: 1px solid #ddd; padding: 10px;">
                            <strong style="color: #343434;">
                                Rental Start Date :
                            </strong>
                            <span t-field="rental.start_date"/>
                        </td>

                        <td style="border: 1px solid #ddd; padding: 10px;">
                            <strong style="color: #343434;">
                                Expected Return Date :
                            </strong>
                            <span t-field="rental.expected_return_date"/>
                        </td>
                    </tr>

                    <t t-if="rental.actual_return_date">
                        <tr>
                            <td style="border: 1px solid #ddd; padding: 10px;">
                                <strong style="color: #343434;">
                                    Actual Return Date :
                                </strong>
                                <span t-field="rental.actual_return_date"/>
                            </td>

                            <td style="border: 1px solid #ddd; padding: 10px;">
                                <strong style="color: #343434;">
                                    Rental Duration :
                                </strong>
                                <span t-field="rental.duration"/>
                                days
                            </td>
                        </tr>
                    </t>

                    <t t-else="">
                        <tr>
                            <td colspan="2"
                                style="border: 1px solid #ddd; padding: 10px;">
                                <strong style="color: #343434;">
                                    Rental Duration :
                                </strong>
                                <span t-field="rental.duration"/>
                                days
                            </td>
                        </tr>
                    </t>

                </table>


                <!-- Financial Summary -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px;">
                    <tr>
                        <td colspan="2"
                            style="background-color: #DDECC0; color: #343434; border: 1px solid #DDECC0; padding: 10px; font-size: 15px;">
                            <strong>Financial Summary</strong>
                        </td>
                    </tr>

                    <tr>
                        <td style="width: 50%; border: 1px solid #ddd; padding: 12px;">
                            <strong style="color: #343434;">
                                Daily Rental Price :
                            </strong>
                            <span t-field="rental.daily_price"/>
                        </td>

                        <td style="width: 50%; border: 1px solid #ddd; padding: 12px;">
                            <strong style="color: #343434;">
                                Total Rental Amount :
                            </strong>

                            <strong style="font-size: 18px; color: #78A82B;">
                                <span t-field="rental.total_amount"/>
                            </strong>
                        </td>
                    </tr>
                </table>


                <!-- Footer -->
                <div style="border-top: 2px solid #DDECC0; margin-top: 30px; padding-top: 10px; color: #6c757d; font-size: 11px;">
                    Rami's Bike Workshop
                </div>

            </div>

        </t>

    </template>

</odoo>
